# Public hostname only, no scheme or path. Point its DNS directly at your server.
SITE_HOST=preview.example.com
ACME_EMAIL=owner@example.com
# Space-separated TESTER public IPs. Never use 0.0.0.0/0 or ::/0 for a private preview.
PREVIEW_ALLOWED_IPS="203.0.113.10/32"
# Use a separate demo project. Its service-account JSON belongs in deploy/secrets/.
FIREBASE_PROJECT_ID=your-demo-project
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-demo-project.firebaseapp.com
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
